<Window x:Class="TokenVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token Vault" Width="1180" Height="760" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Navigation rail ================= -->
    <Border Grid.Column="0" Background="{DynamicResource Nav}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,16,24">
          <Border Width="28" Height="28" Background="{DynamicResource Accent}">
            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource OnAccent}"/>
          </Border>
          <TextBlock Text="Token Vault" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,14,16,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="AccountTile" Style="{StaticResource Tile}" Width="34" Height="34" Background="{DynamicResource Selected}" VerticalAlignment="Top">
              <TextBlock x:Name="AccountInitial" Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Secondary}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock x:Name="AccountName" Text="Not signed in" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="AccountDetail" Text="Microsoft account" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource Link}" FontSize="12.5" Click="SignIn_Click"/>
                <Button x:Name="SignOutButton" Content="Sign out" Style="{StaticResource Link}" FontSize="12.5" Click="SignOut_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel>
          <RadioButton x:Name="NavLibrary" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Library" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavServers" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Servers" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSecurity" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xEA18;" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Security"/>
              <Border x:Name="SecurityBadge" Width="7" Height="7" Background="{DynamicResource Warn}" Margin="8,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= Content ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Error / notice banner -->
      <Border x:Name="Banner" Visibility="Collapsed" Background="{DynamicResource BadTint}" BorderBrush="{DynamicResource Bad}" BorderThickness="3,0,0,0">
        <Grid Margin="16,10,8,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="BannerIcon" Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{DynamicResource Bad}" VerticalAlignment="Top" Margin="0,2,12,0"/>
          <TextBlock x:Name="BannerText" Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center"/>
          <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" ToolTip="Dismiss" Click="Banner_Close"/>
        </Grid>
      </Border>

      <!-- ===== Library ===== -->
      <Grid x:Name="LibraryPage" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="268"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="20,22,12,12">
              <TextBlock Text="Library" Style="{StaticResource Title}" VerticalAlignment="Center"/>
              <Button x:Name="ImportButton" Content="&#xE710;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Import a modpack or mods" Click="Import_Click"/>
            </Grid>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Tertiary}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Style="{StaticResource Caption}" Width="200" Text="Drop a modpack or .jar anywhere to import it."/>
              </StackPanel>
            </Border>
            <ListBox x:Name="Library" Background="Transparent" BorderThickness="0" Padding="0,0,0,8"
                     ItemContainerStyle="{StaticResource Row}" SelectionChanged="Library_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}" Background="{Binding Tile}">
                      <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Instance detail -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Margin="36,32,36,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="InstanceTile" Style="{StaticResource Tile}" Width="72" Height="72" Background="#3B6E52" VerticalAlignment="Top">
              <TextBlock x:Name="InstanceInitial" Text="F" Foreground="#FFFFFF" FontSize="30" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
              <TextBlock x:Name="InstanceTitle" Style="{StaticResource Display}" Text="Minecraft" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <ItemsControl x:Name="InstanceFacts" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" Padding="8,2" Margin="0,0,6,4">
                      <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Secondary}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button x:Name="PlayButton" Style="{StaticResource Primary}" Width="168" Height="46" FontSize="15" Click="Play_Click" IsDefault="True">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,1,10,0"/>
                  <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AddModsButton" Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="Add mods (.jar)" Click="AddMods_Click"/>
                <Button x:Name="OpenFolderButton" Content="&#xE838;" Style="{StaticResource IconButton}" ToolTip="Open instance folder" Click="OpenFolder_Click"/>
                <Button x:Name="RemoveButton" Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove instance" Click="Remove_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Files a CurseForge pack could not download automatically -->
          <Border x:Name="MissingPanel" Grid.Row="1" Visibility="Collapsed" Margin="36,0,36,20" Background="{DynamicResource WarnTint}"
                  BorderBrush="{DynamicResource Warn}" BorderThickness="3,0,0,0" Padding="16,12">
            <StackPanel>
              <TextBlock x:Name="MissingTitle" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,8"
                         Text="The authors of these files don't allow other apps to download them. Open each page, download the file, then drop it on this window."/>
              <ItemsControl x:Name="MissingList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Name}" Tag="{Binding Page}" Style="{StaticResource Link}" Margin="0,2" Click="MissingLink_Click"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Done, hide this" Style="{StaticResource Link}" Foreground="{DynamicResource Secondary}" Margin="0,10,0,0" Click="MissingDone_Click"/>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2" Margin="36,0,36,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TabMods" GroupName="Tabs" Style="{StaticResource Tab}" IsChecked="True" Checked="Tab_Checked">
                <TextBlock><Run Text="Mods"/><Run x:Name="ModCount" Text="" Foreground="{DynamicResource Tertiary}"/></TextBlock>
              </RadioButton>
              <RadioButton x:Name="TabActivity" GroupName="Tabs" Style="{StaticResource Tab}" Content="Activity" Checked="Tab_Checked"/>
            </StackPanel>
            <Rectangle Style="{StaticResource Rule}" VerticalAlignment="Bottom"/>
          </Grid>

          <!-- Mods -->
          <Grid Grid.Row="3" x:Name="ModsView">
            <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0" Padding="20,6,20,16"
                     ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Tile}" Width="32" Height="32" Background="{Binding Tile}">
                      <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="Delete" Grid.Column="3" Content="&#xE74D;" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13"
                            ToolTip="Remove this mod" Tag="{Binding Path}" Click="RemoveMod_Click" Opacity="0"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="Delete" Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="Delete" Property="Opacity" Value="1"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="ModsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,40">
              <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Tertiary}"/>
              <TextBlock Text="No mods yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
              <TextBlock Text="Drop .jar files or a modpack on this window, or press +." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <!-- Activity -->
          <TextBox x:Name="ActivityLog" Grid.Row="3" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" Margin="36,16,36,24"
                   VerticalContentAlignment="Top" Padding="12,10" VerticalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="{DynamicResource Raised}" BorderThickness="0"/>
        </Grid>
      </Grid>

      <!-- ===== Servers ===== -->
      <ScrollViewer x:Name="ServersPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" MaxWidth="760" HorizontalAlignment="Left" Width="760">
          <TextBlock Text="Servers" Style="{StaticResource Display}"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,24" FontSize="14"
                     Text="Token Vault signs you in to these servers only. They show up in Minecraft under Multiplayer."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ServerAddress" KeyDown="ServerAddress_KeyDown" MinHeight="38"/>
            <TextBlock x:Name="ServerHint" Text="Server address, like play.example.net" Foreground="{DynamicResource Tertiary}"
                       IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Add server" Style="{StaticResource Primary}" MinHeight="38" Padding="18,0" Margin="8,0,0,0" Click="AddServer_Click"/>
          </Grid>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,20,0,0">
            <Grid>
              <ItemsControl x:Name="ServerList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12,10,12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Tile}" Background="{Binding Tile}">
                          <TextBlock Text="{Binding Initial}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove server" Tag="{Binding Entry}" Click="RemoveServer_Click"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="ServersEmpty" Margin="0,44" HorizontalAlignment="Center">
                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Tertiary}"/>
                <TextBlock Text="No servers yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Singleplayer works without one." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Tertiary}" VerticalAlignment="Top" Margin="0,2,10,0"/>
            <TextBlock Style="{StaticResource Caption}" Width="700"
                       Text="Servers you add inside Minecraft can't sign you in, because the game never has your account. Add them here instead."/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Security ===== -->
      <ScrollViewer x:Name="SecurityPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" Width="760" HorizontalAlignment="Left">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SecurityHero" Width="56" Height="56" Background="{DynamicResource Accent}">
              <TextBlock x:Name="SecurityHeroIcon" Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource OnAccent}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="SecurityTitle" Text="Your account is protected" Style="{StaticResource Display}"/>
              <TextBlock x:Name="SecuritySummary" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="Protection" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}" Margin="0,30,0,8"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Secondary}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                  <TextBlock Text="Ask before joining a server" FontWeight="SemiBold"/>
                  <TextBlock Text="Token Vault asks you each time the game signs in to a server, so a mod can't quietly join as you." Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ConfirmJoinsSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="ConfirmJoins_Click"/>
              </Grid>
              <Rectangle Style="{StaticResource Rule}"/>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Secondary}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                  <TextBlock Text="Let the game use the clipboard" FontWeight="SemiBold"/>
                  <TextBlock Text="Off keeps what you copy, like passwords, away from mods. Turn on to copy and paste in chat." Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ClipboardSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Clipboard_Click"/>
              </Grid>
              <Rectangle Style="{StaticResource Rule}"/>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Secondary}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                  <TextBlock Text="Stay signed in on this PC" FontWeight="SemiBold"/>
                  <TextBlock Text="Saved encrypted for your Windows account. The game can't read it." Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox x:Name="RememberSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="Remember_Click"/>
              </Grid>
              <Rectangle Style="{StaticResource Rule}"/>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Secondary}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                  <TextBlock Text="Sandbox networking" FontWeight="SemiBold"/>
                  <TextBlock x:Name="NetworkDetail" Text="" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="NetworkOk" Foreground="{DynamicResource Good}" VerticalAlignment="Center" Visibility="Collapsed"><Run Text="&#xE73E;" FontFamily="{StaticResource IconFont}"/><Run Text="  Approved"/></TextBlock>
                  <Button x:Name="NetworkButton" Content="Approve" Click="Network_Click"/>
                </StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource Rule}"/>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource Secondary}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                  <TextBlock Text="Saved sign-in" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SavedDetail" Text="" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="ForgetButton" Grid.Column="2" Content="Sign out" VerticalAlignment="Center" Click="SignOut_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <Grid Margin="0,30,0,8">
            <TextBlock Text="Activity" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}"/>
            <Button x:Name="ClearActivityButton" Content="Clear" Style="{StaticResource Link}" HorizontalAlignment="Right" FontWeight="Normal" Click="ClearActivity_Click"/>
          </Grid>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid>
              <ItemsControl x:Name="ActivityList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12.5"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="ActivityEmpty" Margin="0,30" HorizontalAlignment="Center">
                <TextBlock Text="Nothing yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Server joins, and anything Token Vault blocks, show up here while you play." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="How you're protected" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}" Margin="0,30,0,12"/>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,24,18">
              <TextBlock><Run Text="&#xE72E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Good}"/><Run Text="  Your sign-in never enters the game" FontWeight="SemiBold"/></TextBlock>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Minecraft gets a stand-in token that Mojang rejects. Your real tokens stay in Token Vault."/>
            </StackPanel>
            <StackPanel Margin="0,0,24,18">
              <TextBlock><Run Text="&#xEA18;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Good}"/><Run Text="  Mods run in a Windows sandbox" FontWeight="SemiBold"/></TextBlock>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="They can't open your files, browsers, other launchers or Token Vault, and can only write to their own folder."/>
            </StackPanel>
            <StackPanel Margin="0,0,24,18">
              <TextBlock><Run Text="&#xE774;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Good}"/><Run Text="  Token Vault joins servers itself" FontWeight="SemiBold"/></TextBlock>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Only servers on your list, one connection at a time. The game can't sign in anywhere on its own."/>
            </StackPanel>
            <StackPanel Margin="0,0,24,18">
              <TextBlock><Run Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Good}"/><Run Text="  Account changes are blocked" FontWeight="SemiBold"/></TextBlock>
              <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Name changes, skin changes and every other account request from the game are refused."/>
            </StackPanel>
          </UniformGrid>

          <TextBlock Text="What Token Vault can't stop" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}" Margin="0,18,0,8"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <ItemsControl x:Name="LimitsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Tertiary}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12.5"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ===== Settings ===== -->
      <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,40,40" Width="720" HorizontalAlignment="Left">
          <TextBlock Text="Settings" Style="{StaticResource Display}"/>

          <TextBlock Text="Game" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}" Margin="0,28,0,8"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Memory" FontWeight="SemiBold"/>
                  <TextBlock Text="How much RAM Minecraft may use." Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="MemoryBox" Width="90" TextAlignment="Right"/>
                  <TextBlock Text="MB" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
              <Rectangle Style="{StaticResource Rule}"/>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Java" FontWeight="SemiBold"/>
                  <TextBlock Text="Empty uses the Java Token Vault installs. A JDK 25 adds a self-check before launch." Style="{StaticResource Caption}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBox x:Name="JavaBox" Width="260"/>
                  <Button Content="Browse…" Margin="8,0,0,0" Click="BrowseJava_Click"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Sign-in" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}" Margin="0,28,0,8"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel>
              <CheckBox x:Name="DeviceCodeBox" Margin="18,14">
                <StackPanel>
                  <TextBlock Text="Sign in with a code" FontWeight="SemiBold"/>
                  <TextBlock Text="Type a short code on microsoft.com/link instead of using a browser pop-up." Style="{StaticResource Caption}"/>
                </StackPanel>
              </CheckBox>
              <Rectangle Style="{StaticResource Rule}"/>
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="Microsoft application ID" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ClientIdHint" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBox x:Name="ClientIdBox" Grid.Column="1" Width="300" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="Storage" Style="{StaticResource Subtitle}" Foreground="{DynamicResource Secondary}" Margin="0,28,0,8"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid Margin="18,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Game files and sign-in data" FontWeight="SemiBold"/>
                <TextBlock Text="Stored under %LOCALAPPDATA%\TokenVault." Style="{StaticResource Caption}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Game files" Click="OpenInstall_Click"/>
                <Button Content="Data" Margin="8,0,0,0" Click="OpenData_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Revert" Click="SettingsRevert_Click"/>
            <Button Content="Save changes" Style="{StaticResource Primary}" Padding="20,0" Margin="8,0,0,0" Click="SettingsSave_Click"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================= Status bar ================= -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Nav}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Height="34">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Good}" Margin="0,0,10,0"/>
          <TextBlock x:Name="StatusText" Text="Ready" FontSize="12.5" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel x:Name="ProgressArea" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{DynamicResource Tertiary}" Margin="0,0,12,0"/>
          <ProgressBar x:Name="Progress" Width="180" Minimum="0" Maximum="1"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= Dialog overlay ================= -->
    <Grid x:Name="Overlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Scrim}" Visibility="Collapsed">
      <Border Width="460" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
        <StackPanel>
          <TextBlock x:Name="DialogTitle" Style="{StaticResource Title}"/>
          <TextBlock x:Name="DialogBody" Style="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="20"/>
          <TextBox x:Name="DialogCode" Visibility="Collapsed" IsReadOnly="True" Margin="0,18,0,0" MinHeight="56" HorizontalContentAlignment="Center"
                   FontFamily="Cascadia Mono, Consolas" FontSize="28" FontWeight="SemiBold" Background="{DynamicResource Raised}" BorderThickness="0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="DialogSecondary" Content="Cancel" Click="DialogSecondary_Click"/>
            <Button x:Name="DialogPrimary" Content="OK" Style="{StaticResource Primary}" Padding="20,0" Margin="8,0,0,0" Click="DialogPrimary_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
