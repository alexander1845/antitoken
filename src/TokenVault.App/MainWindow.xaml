<Window x:Class="TokenVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token Vault" Width="1040" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Ui}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar: library, import, account ===== -->
    <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="20,26,20,18">
          <TextBlock Text="Token Vault" Style="{StaticResource Heading}" FontSize="20"/>
          <TextBlock Text="Minecraft with sandboxed mods" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Rectangle Style="{StaticResource Rule}"/>
          <StackPanel Margin="20,14,20,18">
            <TextBlock Text="ACCOUNT" Style="{StaticResource Caps}"/>
            <TextBlock x:Name="AccountName" Text="Not signed in" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="AccountDetail" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,8"
                       Text="You'll sign in with Microsoft when you press Play."/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource Link}" Click="SignIn_Click"/>
              <Button x:Name="SignOutButton" Content="Sign out" Style="{StaticResource Link}" Click="SignOut_Click" Margin="0,0,0,0"/>
              <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource Link}" Click="Settings_Click" Margin="18,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,16">
          <Button x:Name="ImportButton" Content="Import modpack…" HorizontalContentAlignment="Left" Click="Import_Click"/>
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                     Text=".mrpack · CurseForge · Prism/MultiMC · .zip .7z .rar .tar.gz · .jar — or drop files here"/>
        </StackPanel>

        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Style="{StaticResource Caps}" Margin="20,4,20,6"/>
          <ListBox x:Name="Library" Background="Transparent" BorderThickness="0" Padding="0"
                   ItemContainerStyle="{StaticResource LibraryItem}" SelectionChanged="Library_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- ===== Main: the selected instance ===== -->
    <ScrollViewer x:Name="HomePage" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="44,38,44,40" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock x:Name="InstanceTitle" Style="{StaticResource Title}" Text="Minecraft"/>
        <TextBlock x:Name="InstanceDetail" Style="{StaticResource Muted}" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
          <Button x:Name="PlayButton" Content="Play" Style="{StaticResource Primary}" MinWidth="150" Click="Play_Click" IsDefault="True"/>
          <Button x:Name="OpenFolderButton" Content="Open folder" Margin="12,0,0,0" Click="OpenFolder_Click"/>
          <Button x:Name="AddModsButton" Content="Add mods…" Margin="8,0,0,0" Click="AddMods_Click"/>
          <Button x:Name="RemoveButton" Content="Remove" Margin="8,0,0,0" Click="Remove_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,16,0,6" Text="Ready to play."/>
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Visibility="Hidden"/>

        <!-- Sign-in code (only when code sign-in is chosen) -->
        <Border x:Name="CodePanel" Visibility="Collapsed" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18,14" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Enter this code on Microsoft's page" FontWeight="SemiBold"/>
            <TextBox x:Name="CodeText" IsReadOnly="True" BorderThickness="0" Padding="0" Margin="0,6,0,6"
                     FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" Background="Transparent"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Copy code and open Microsoft" Click="OpenCodePage_Click"/>
              <TextBlock x:Name="CodeUrl" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Files a CurseForge pack could not download automatically -->
        <StackPanel x:Name="MissingPanel" Visibility="Collapsed" Margin="0,18,0,0">
          <TextBlock x:Name="MissingTitle" FontWeight="SemiBold" Foreground="{DynamicResource Warn}"/>
          <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,6"
                     Text="The pack's authors don't allow other apps to download these. Download each from its page and drop it on this window."/>
          <ItemsControl x:Name="MissingList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}" Tag="{Binding Page}" Style="{StaticResource Link}" Margin="0,3" Click="MissingLink_Click"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="I've added them" Style="{StaticResource Link}" Margin="0,8,0,0" Click="MissingDone_Click"/>
        </StackPanel>

        <Rectangle Style="{StaticResource Rule}" Margin="0,32,0,26"/>

        <!-- Servers -->
        <TextBlock Text="Servers" Style="{StaticResource Heading}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                   Text="Token Vault signs you in to these servers only. They appear in the game's Multiplayer list."/>
        <ItemsControl x:Name="ServerList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,9">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" FontSize="12.5"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Remove" Style="{StaticResource Link}" Tag="{Binding Entry}" VerticalAlignment="Center" Click="RemoveServer_Click"/>
                <Rectangle Grid.ColumnSpan="2" Style="{StaticResource Rule}" VerticalAlignment="Bottom"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoServers" Style="{StaticResource Muted}" Text="No servers yet. Singleplayer works without one." Margin="0,2,0,6"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ServerAddress" KeyDown="ServerAddress_KeyDown"/>
          <TextBlock x:Name="ServerHint" Text="Server address, e.g. play.example.net" Style="{StaticResource Muted}" IsHitTestVisible="False"
                     Margin="10,0,0,0" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Add server" Margin="8,0,0,0" Click="AddServer_Click"/>
        </Grid>

        <Rectangle Style="{StaticResource Rule}" Margin="0,32,0,26"/>

        <!-- Protection: plain-language status -->
        <TextBlock Text="Protection" Style="{StaticResource Heading}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8" Text="What keeps your account safe while mods run."/>
        <ItemsControl x:Name="ProtectionList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Body}"/>
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding Action}" Tag="{Binding Key}" Style="{StaticResource Link}" Margin="16,0,0,0"
                        VerticalAlignment="Top" Visibility="{Binding ActionVisibility}" Click="ProtectionAction_Click"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="LimitsToggle" Content="What this can't protect against" Style="{StaticResource Link}" Margin="26,10,0,0" Click="LimitsToggle_Click"/>
        <TextBlock x:Name="LimitsText" Style="{StaticResource Muted}" Margin="26,8,0,0" Visibility="Collapsed" LineHeight="20"/>

        <Rectangle Style="{StaticResource Rule}" Margin="0,32,0,18"/>
        <Button x:Name="ActivityToggle" Content="Show activity" Style="{StaticResource Link}" Click="ActivityToggle_Click"/>
        <TextBox x:Name="ActivityLog" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" Height="180" Margin="0,10,0,0"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Settings ===== -->
    <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="44,38,44,40" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource Title}"/>

        <TextBlock Text="Game" Style="{StaticResource Heading}" Margin="0,28,0,10"/>
        <TextBlock Text="Memory for Minecraft (MB)"/>
        <TextBox x:Name="MemoryBox" Width="120" HorizontalAlignment="Left" Margin="0,6,0,16"/>
        <TextBlock Text="Java"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="Leave empty to use the Java that Token Vault installs. A JDK 25 enables an extra self-check before each launch."/>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="JavaBox"/>
          <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseJava_Click"/>
        </Grid>

        <TextBlock Text="Sign-in" Style="{StaticResource Heading}" Margin="0,30,0,10"/>
        <CheckBox x:Name="RememberBox" Content="Stay signed in on this PC (encrypted for your Windows account)"/>
        <CheckBox x:Name="DeviceCodeBox" Content="Sign in with a code instead of a browser window" Margin="0,10,0,0"/>
        <TextBlock Text="Microsoft application ID" Margin="0,18,0,0"/>
        <TextBlock x:Name="ClientIdHint" Style="{StaticResource Muted}" FontSize="12.5"/>
        <TextBox x:Name="ClientIdBox" Margin="0,6,0,0"/>

        <TextBlock Text="Folders" Style="{StaticResource Heading}" Margin="0,30,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Open game install" Click="OpenInstall_Click"/>
          <Button Content="Open Token Vault data" Margin="8,0,0,0" Click="OpenData_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,34,0,0">
          <Button Content="Done" Style="{StaticResource Primary}" FontSize="13.5" Padding="22,8" Click="SettingsDone_Click"/>
          <Button Content="Cancel" Margin="8,0,0,0" Click="SettingsCancel_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
